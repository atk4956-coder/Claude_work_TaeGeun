# 국토교통부 실거래가 Open API
# 발급처: data.go.kr (공공데이터포털)
# - data.go.kr에 가입 후 "국토교통부_아파트매매 실거래가" 검색
# - 활용신청 후 마이페이지 > 개발계정에서 인증키 확인 (디코딩/인코딩 키 중 선택)
MOLIT_SERVICE_KEY=your_molit_service_key_here

# 한국부동산원 Open API (선택사항)
# 발급처: data.go.kr 또는 R-ONE 통계포털
# (현재 정확한 접근 경로는 미확정 — Phase 4에서 재확인 예정)
KREA_API_KEY=your_krea_api_key_here

# KB부동산 Open API (선택사항)
# 발급 요건이 표준화되어 있지 않을 수 있음 (Phase 5+ 예정)
KB_API_KEY=your_kb_api_key_here

# 데이터베이스
# SQLite 사용 (파일 경로)
DATABASE_FILE_PATH=./data/real-estate.sqlite

# 서버 포트
BACKEND_PORT=3001

# 환경 (development / production)
NODE_ENV=development
